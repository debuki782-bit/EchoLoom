+static bool ExactWeixinVersion(const std::wstring& exe, std::wstring& err) {
+  DWORD ignored = 0;
+  const DWORD size = GetFileVersionInfoSizeW(exe.c_str(), &ignored);
+  if (!size) { err = L"Cannot read Weixin.exe version"; return false; }
+  std::vector<BYTE> data(size);
+  if (!GetFileVersionInfoW(exe.c_str(), 0, size, data.data())) {
+    err = L"Cannot read Weixin.exe version"; return false;
+  }
+  VS_FIXEDFILEINFO* info = nullptr;
+  UINT length = 0;
+  if (!VerQueryValueW(data.data(), L"\\", reinterpret_cast<LPVOID*>(&info), &length) ||
+      !info || length < sizeof(VS_FIXEDFILEINFO) || info->dwSignature != 0xFEEF04BD) {
+    err = L"Invalid Weixin.exe version resource"; return false;
+  }
+  if (info->dwProductVersionMS != MAKELONG(1, 4) ||
+      info->dwProductVersionLS != MAKELONG(27, 10)) {
+    err = L"Weixin.exe must be exactly 4.1.10.27"; return false;
+  }
+  return true;
+}
