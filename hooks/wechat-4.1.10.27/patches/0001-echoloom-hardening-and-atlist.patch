+static std::wstring EnvOrDefault(const wchar_t* name, const wchar_t* fallback) {
+  wchar_t buf[512]{};
+  DWORD len = GetEnvironmentVariableW(name, buf, 512);
+  if (len > 0 && len < 512) return std::wstring(buf, len);
+  return std::wstring(fallback);
