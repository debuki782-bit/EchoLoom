+                        constexpr size_t kOffsets[] = {0x70, 0x90, 0x48, 0xb0, 0xd0, 0xf0, 0x130};
+                        for (size_t off : kOffsets) {
+                            const std::string s = ReadStrBounded(p + off, 4096);
+                            if (s.empty()) continue;
+                            if (done.aeskey.empty() && s.size() == 32 && IsHex(s.data(), s.size())) {
+                                done.aeskey = s;
+                            } else if (done.fileid.empty() && s.size() >= 60 && IsHex(s.data(), s.size())) {
+                                done.fileid = s;
+                            }
+                        }
+                    }
+                    std::lock_guard<std::mutex> lock(g_cdnMutex);
+                    if (g_completed.size() >= 256) g_completed.clear();
+                    g_completed[key] = std::move(done);
+                    g_tracked.erase(key);
+                }
+            }
+            return g_origUlCbCall(taskKeyPtr, resultPtr, taskPtr);
+        }
