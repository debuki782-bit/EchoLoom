+        bool TryReadWxStr(const void* field, char* buf, size_t cap, size_t* outLen) {
+            __try {
+                if (!field || !buf || !outLen || cap == 0) return false;
+                const auto words = static_cast<const uintptr_t*>(field);
+                const size_t len = words[2];
+                const size_t scap = words[3];
+                if (len >= cap || scap < len) return false;
+                const char* src = scap < 16 ? static_cast<const char*>(field) : reinterpret_cast<const char*>(words[0]);
+                if (!src) return false;
+                std::memcpy(buf, src, len);
+                buf[len] = '\0';
+                *outLen = len;
+                return true;
+            } __except (EXCEPTION_EXECUTE_HANDLER) { return false; }
+        }
+
+        std::string ReadStrBounded(const void* field, size_t maxLen) {
+            std::vector<char> buf(maxLen + 1, '\0');
