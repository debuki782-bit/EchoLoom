+#include "httplib.h"
+#include "json.hpp"
+#include <windows.h>
+#include <filesystem>
+#include "global.h"
+#include "wx_send.h"
+#include "SendFileMsg.h"
+
+using json = nlohmann::json;
+
+namespace {
+bool Utf8ToWidePath(const std::string& utf8, std::wstring& out) {
+    if (utf8.empty() || utf8.size() > 32768 || utf8.find('\0') != std::string::npos) {
+        return false;
+    }
+    const int needed = MultiByteToWideChar(
+        CP_UTF8, MB_ERR_INVALID_CHARS, utf8.data(), static_cast<int>(utf8.size()), nullptr, 0);
+    if (needed <= 0) return false;
+    out.resize(static_cast<size_t>(needed));
+    const int written = MultiByteToWideChar(
+        CP_UTF8, MB_ERR_INVALID_CHARS, utf8.data(), static_cast<int>(utf8.size()), out.data(), needed);
+    return written == needed;
+}
+}
+
+void Route_SendFileMsg(httplib::Server& svr)
+{
+    svr.Post("/SendFileMsg", [](const httplib::Request& req, httplib::Response& res)
+        {
+            json reqJson;
+            json resp;
+
+            try
+            {
+                reqJson = json::parse(req.body);
+            }
+            catch (...)
+            {
+                resp["ret"] = -1;
+                resp["msg"] = "invalid json";
+                res.set_content(resp.dump(), "application/json; charset=utf-8");
+                return;
+            }
+
+            std::string toWxid = reqJson.value("to_wxid", "");
+            if (toWxid.empty()) toWxid = reqJson.value("wxidorgid", "");
+            std::string filePath = reqJson.value("file_path", "");
+            if (filePath.empty()) filePath = reqJson.value("path", "");
+
+            res.set_header("Content-Type", "application/json; charset=utf-8");
+            if (!g_IsLogin) {
+                resp["ret"] = -2;
+                resp["msg"] = "not logged in";
+                res.set_content(resp.dump(), "application/json; charset=utf-8");
+                return;
+            }
+            if (toWxid.empty() || filePath.empty() || filePath.size() > 32768 ||
+                toWxid.find('\0') != std::string::npos || filePath.find('\0') != std::string::npos) {
+                resp["ret"] = -1;
+                resp["msg"] = "to_wxid and file_path are required";
+                res.set_content(resp.dump(), "application/json; charset=utf-8");
+                return;
+            }
+
+            std::wstring widePath;
+            std::error_code fileError;
+            if (!Utf8ToWidePath(filePath, widePath)) {
+                resp["ret"] = -1;
+                resp["msg"] = "file_path must be valid UTF-8";
+                res.set_content(resp.dump(), "application/json; charset=utf-8");
+                return;
+            }
+            const std::filesystem::path fsPath(widePath);
+            if (!std::filesystem::is_regular_file(fsPath, fileError) || fileError) {
+                resp["ret"] = -1;
+                resp["msg"] = "file_path is not a readable regular file";
+                res.set_content(resp.dump(), "application/json; charset=utf-8");
+                return;
+            }
+            const auto fileSize = std::filesystem::file_size(fsPath, fileError);
+            if (fileError || fileSize == 0 || fileSize > 200ULL * 1024ULL * 1024ULL) {
+                resp["ret"] = -1;
+                resp["msg"] = "file size out of range (1B..200MB)";
+                res.set_content(resp.dump(), "application/json; charset=utf-8");
+                return;
+            }
+
+            std::string error;
+            const bool sent = WeixinSend::SendFile(toWxid, filePath, error);
+            if (sent) {
+                resp["ret"] = 0;
+                resp["retmsg"] = "success";
+                resp["sent"] = true;
+            } else if (error == "appmsg_manager_not_ready" ||
+                       error == "cdn_callback_not_ready" ||
+                       error == "cdn_hook_not_installed") {
+                resp["ret"] = -5;
+                resp["retmsg"] = error;
+                resp["sent"] = false;
+            } else {
+                resp["ret"] = -3;
+                resp["retmsg"] = error.empty() ? "send file failed" : error;
+                resp["sent"] = false;
+            }
+            res.set_content(resp.dump(), "application/json; charset=utf-8");
+        });
+}
