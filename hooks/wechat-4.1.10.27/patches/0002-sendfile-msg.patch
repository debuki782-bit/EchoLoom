+        bool Utf8ToWide(const std::string& utf8, std::wstring& out) {
+            const int n = MultiByteToWideChar(
+                CP_UTF8, MB_ERR_INVALID_CHARS, utf8.data(), static_cast<int>(utf8.size()), nullptr, 0);
+            if (n <= 0) return false;
+            out.resize(static_cast<size_t>(n));
+            return MultiByteToWideChar(
+                CP_UTF8, MB_ERR_INVALID_CHARS, utf8.data(), static_cast<int>(utf8.size()), out.data(), n) == n;
+        }
+
+        std::string WideToUtf8(const std::wstring& w) {
+            if (w.empty()) return {};
+            const int n = WideCharToMultiByte(CP_UTF8, 0, w.data(), static_cast<int>(w.size()), nullptr, 0, nullptr, nullptr);
+            if (n <= 0) return {};
+            std::string out(static_cast<size_t>(n), '\0');
+            WideCharToMultiByte(CP_UTF8, 0, w.data(), static_cast<int>(w.size()), out.data(), n, nullptr, nullptr);
+            return out;
+        }
+
+        bool ComputeFileMd5AndSize(const std::wstring& wpath, std::string& md5Hex, uint64_t& byteCount) {
+            HANDLE hFile = CreateFileW(
+                wpath.c_str(), GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                nullptr, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr);
+            if (hFile == INVALID_HANDLE_VALUE) return false;
+            LARGE_INTEGER li{};
+            if (!GetFileSizeEx(hFile, &li) || li.QuadPart <= 0) {
+                CloseHandle(hFile);
+                return false;
+            }
+            byteCount = static_cast<uint64_t>(li.QuadPart);
+
+            BCRYPT_ALG_HANDLE alg = nullptr;
+            BCRYPT_HASH_HANDLE hash = nullptr;
+            DWORD objSize = 0, cbData = 0;
+            bool ok = BCryptOpenAlgorithmProvider(&alg, BCRYPT_MD5_ALGORITHM, nullptr, 0) == 0;
+            if (ok) ok = BCryptGetProperty(alg, BCRYPT_OBJECT_LENGTH, reinterpret_cast<PUCHAR>(&objSize), sizeof(objSize), &cbData, 0) == 0;
+            std::vector<unsigned char> obj(objSize);
+            if (ok) ok = BCryptCreateHash(alg, &hash, obj.data(), objSize, nullptr, 0, 0) == 0;
+            std::vector<unsigned char> buf(65536);
+            DWORD readBytes = 0;
+            while (ok && ReadFile(hFile, buf.data(), static_cast<DWORD>(buf.size()), &readBytes, nullptr) && readBytes > 0) {
+                ok = BCryptHashData(hash, buf.data(), readBytes, 0) == 0;
+            }
+            unsigned char digest[16]{};
+            if (ok) ok = BCryptFinishHash(hash, digest, sizeof(digest), 0) == 0;
+            if (hash) BCryptDestroyHash(hash);
+            if (alg) BCryptCloseAlgorithmProvider(alg, 0);
+            CloseHandle(hFile);
+            if (!ok) return false;
+            char hex[33]{};
+            for (size_t i = 0; i < 16; ++i) snprintf(hex + i * 2, 3, "%02x", digest[i]);
+            md5Hex.assign(hex, 32);
+            return true;
+        }
+
+        std::string EscapeXml(const std::string& text) {
+            std::string out;
+            out.reserve(text.size() + 16);
+            for (char ch : text) {
+                switch (ch) {
+                case '&': out += "&amp;"; break;
+                case '<': out += "&lt;"; break;
+                case '>': out += "&gt;"; break;
+                case '"': out += "&quot;"; break;
+                case '\'': out += "&apos;"; break;
+                default: out += ch; break;
+                }
+            }
+            return out;
+        }
+    }
+
+    void InstallFileCdnHooks()
+    {
+        if (FileTransfer::g_hooksReady.load()) return;
+        uintptr_t base = GetWeixinDllBase();
+        if (!base) return;
+        FileTransfer::g_base = base;
+
+        const unsigned char pMgr[]{0x55, 0x41, 0x56, 0x56, 0x57, 0x53, 0x48, 0x81};
+        const unsigned char pCb[]{0x55, 0x41, 0x57, 0x41, 0x56, 0x41, 0x55, 0x41};
+        const unsigned char pDtor[]{0x41, 0x56, 0x56, 0x57, 0x53};
+        if (std::memcmp(reinterpret_cast<void*>(base + FileTransfer::kCdnMgrDlStart), pMgr, sizeof(pMgr)) ||
+            std::memcmp(reinterpret_cast<void*>(base + FileTransfer::kCdnMgrUlStart), pMgr, sizeof(pMgr)) ||
+            std::memcmp(reinterpret_cast<void*>(base + FileTransfer::kCdnUlCbCall), pCb, sizeof(pCb)) ||
+            std::memcmp(reinterpret_cast<void*>(base + FileTransfer::kDestructUpload), pDtor, sizeof(pDtor))) {
+            return;
+        }
+
+        auto hookOne = [base](uintptr_t rva, LPVOID detour, LPVOID* orig) -> bool {
+            void* target = reinterpret_cast<void*>(base + rva);
+            if (MH_CreateHook(target, detour, orig) != MH_OK) return false;
+            return MH_EnableHook(target) == MH_OK;
+        };
+        if (hookOne(FileTransfer::kCdnMgrDlStart, FileTransfer::HookMgrDlStart, reinterpret_cast<LPVOID*>(&FileTransfer::g_origMgrDlStart)) &&
+            hookOne(FileTransfer::kCdnMgrUlStart, FileTransfer::HookMgrUlStart, reinterpret_cast<LPVOID*>(&FileTransfer::g_origMgrUlStart)) &&
+            hookOne(FileTransfer::kCdnUlCbCall, FileTransfer::HookUlCbCall, reinterpret_cast<LPVOID*>(&FileTransfer::g_origUlCbCall))) {
+            FileTransfer::g_hooksReady.store(true);
+        }
+    }
+
+    bool SendFile(const std::string& to_wxid, const std::string& file_path, std::string& error_out)
+    {
+        error_out.clear();
+        if (to_wxid.empty() || file_path.empty() || !GetModuleHandleA("Weixin.dll")) {
+            error_out = "invalid_arguments";
+            return false;
+        }
+        if (g_AppMsgSubmitManager == 0) {
+            error_out = "appmsg_manager_not_ready";
+            return false;
+        }
+        if (!FileTransfer::g_hooksReady.load()) {
+            error_out = "cdn_hook_not_installed";
+            return false;
+        }
+        uintptr_t base = GetWeixinDllBase();
+        if (!base) {
+            error_out = "weixin_dll_not_found";
+            return false;
+        }
+        std::shared_ptr<void> retained;
+        {
+            std::lock_guard<std::mutex> lock(FileTransfer::g_cdnMutex);
+            retained = FileTransfer::g_callback;
+        }
+        if (!retained) {
+            error_out = "cdn_callback_not_ready";
+            return false;
+        }
+
+        std::wstring wpath;
+        if (!FileTransfer::Utf8ToWide(file_path, wpath)) {
+            error_out = "invalid_utf8_path";
+            return false;
+        }
+        std::string md5Hex;
+        uint64_t byteCount = 0;
+        if (!FileTransfer::ComputeFileMd5AndSize(wpath, md5Hex, byteCount) ||
+            byteCount == 0 || byteCount > 200ULL * 1024ULL * 1024ULL) {
+            error_out = "file_read_or_size_error";
+            return false;
+        }
+
+        const std::filesystem::path fsPath(wpath);
+        const std::string title = FileTransfer::WideToUtf8(fsPath.filename().wstring());
+        std::wstring wext = fsPath.extension().wstring();
+        if (!wext.empty() && wext[0] == L'.') wext.erase(0, 1);
+        const std::string fileext = FileTransfer::WideToUtf8(wext);
+
+        const uint64_t seq = ++FileTransfer::g_taskSeq;
+        const std::string taskKey = format_string("hook_file_%llu_%llu",
+            static_cast<unsigned long long>(GetTickCount64()), static_cast<unsigned long long>(seq));
+        {
+            std::lock_guard<std::mutex> lock(FileTransfer::g_cdnMutex);
+            if (FileTransfer::g_tracked.size() >= 256) FileTransfer::g_tracked.clear();
+            FileTransfer::g_tracked.insert(taskKey);
+            FileTransfer::g_completed.erase(taskKey);
+        }
+
+        const unsigned fileType = byteCount > 25ULL * 1024ULL * 1024ULL ? 7u : 5u;
+        alignas(16) unsigned char reqBuf[FileTransfer::kUploadRequestBytes]{};
+        FileTransfer::InitUploadReq(reqBuf, fileType);
+        *reinterpret_cast<std::shared_ptr<void>*>(reqBuf) = retained;
+        const bool assigned =
+            FileTransfer::AssignNativeStr(base, reqBuf + 0x10, taskKey.c_str(), taskKey.size()) &&
+            FileTransfer::AssignNativeStr(base, reqBuf + 0x58, taskKey.c_str(), taskKey.size()) &&
+            FileTransfer::AssignNativeStr(base, reqBuf + 0x120, file_path.c_str(), file_path.size());
+        const int rc = assigned ? FileTransfer::CallStartUpload(base, reqBuf) : INT_MIN;
+        FileTransfer::DestructUploadReq(base, reqBuf);
+        if (rc != 0) {
+            std::lock_guard<std::mutex> lock(FileTransfer::g_cdnMutex);
+            FileTransfer::g_tracked.erase(taskKey);
+            error_out = format_string("cdn_upload_submit_failed_%d", rc);
+            return false;
+        }
+
+        FileTransfer::UploadDone done;
+        bool finished = false;
+        const ULONGLONG deadline = GetTickCount64() + 45000ULL;
+        while (GetTickCount64() < deadline) {
+            {
+                std::lock_guard<std::mutex> lock(FileTransfer::g_cdnMutex);
+                const auto it = FileTransfer::g_completed.find(taskKey);
+                if (it != FileTransfer::g_completed.end()) {
+                    done = it->second;
+                    FileTransfer::g_completed.erase(it);
+                    finished = true;
+                }
+            }
+            if (finished) break;
+            Sleep(50);
+        }
+        if (!finished) {
+            std::lock_guard<std::mutex> lock(FileTransfer::g_cdnMutex);
+            FileTransfer::g_tracked.erase(taskKey);
+            error_out = "cdn_upload_timeout";
+            return false;
+        }
+        if (done.code != 0 || done.fileid.empty() || done.aeskey.size() != 32) {
+            error_out = format_string("cdn_upload_completion_%d", done.code);
+            return false;
+        }
+
+        const std::string attachId = "@cdn_" + done.fileid + "_" + done.aeskey + "_1";
+        const std::string xml =
+            "<appmsg appid=\"\" sdkver=\"0\">"
+            "<title>" + FileTransfer::EscapeXml(title) + "</title>"
+            "<des></des>"
+            "<action>view</action>"
+            "<type>6</type>"
+            "<showtype>0</showtype>"
+            "<soundtype>0</soundtype>"
+            "<mediatagname></mediatagname>"
+            "<messageext></messageext>"
+            "<messageaction></messageaction>"
+            "<content></content>"
+            "<contentattr>0</contentattr>"
+            "<url></url><lowurl></lowurl><dataurl></dataurl><lowdataurl></lowdataurl>"
+            "<appattach>"
+            "<totallen>" + std::to_string(byteCount) + "</totallen>"
+            "<attachid>" + attachId + "</attachid>"
+            "<cdnattachurl>" + done.fileid + "</cdnattachurl>"
+            "<aeskey>" + done.aeskey + "</aeskey>"
+            "<encryver>0</encryver>"
+            "<fileext>" + FileTransfer::EscapeXml(fileext) + "</fileext>"
+            "</appattach>"
+            "<extinfo></extinfo><sourceusername></sourceusername><sourcedisplayname></sourcedisplayname>"
+            "<thumburl></thumburl><md5>" + md5Hex + "</md5><statextstr></statextstr>"
+            "</appmsg>";
+
+        if (!SendAppMsg(to_wxid, xml, 6)) {
+            error_out = "send_appmsg_failed";
+            return false;
+        }
+        return true;
+    }
 }
