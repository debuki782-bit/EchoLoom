# EchoLoom environment configuration template.
# Private configs & prompts belong under `.local/` (gitignored).
WECHAT_AGENT_DB=data/agent.sqlite3
WECHAT_AGENT_HOST=127.0.0.1
WECHAT_AGENT_PORT=8080
ECHOLOOM_GATEWAY_FACTORY=echoloom.connectors.webhook:WebhookConnector
# Optional shared secret for webhook/source ingestion authentication:
# ECHOLOOM_WEBHOOK_SECRET=change-me
# Optional API keys (or store encrypted in OS credential store via python -m echoloom.credentials store):
# GEMINI_API_KEY=
# OPENAI_API_KEY=
